# RHEL8 stand-in: Rocky Linux 8 has full RHEL8-compatible repositories.
# It lacks a usable default ansible python (3.6), so python3.11 from
# appstream is installed and selected via ansible_python_interpreter.
FROM rockylinux:8

RUN dnf -y install epel-release \
    && dnf -y config-manager --set-enabled powertools \
    && dnf -y --allowerasing install \
        python3 \
        python3.11 \
        python3-dnf \
        sudo \
        curl \
        tar \
    && dnf clean all